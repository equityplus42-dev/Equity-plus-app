# ─────────────────────────────────────────────────────────────────────────────
#  Loop Referral Network — Backend Environment Template
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# TiDB Cloud connection string (MySQL-compatible)
DATABASE_URL="mysql://user:password@host:4000/referral_db?sslaccept=strict"

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── JWT ───────────────────────────────────────────────────────────────────────
# Use a long, random string in production (minimum 32 characters)
JWT_SECRET=change_me_to_a_strong_random_secret_minimum_32_chars
JWT_EXPIRES_IN=7d

# ── Primary Cloudinary (Avatars, Thumbnails, Marketing Images) ─────────────────
CLOUDINARY_CLOUD_NAME=your_primary_cloud_name
CLOUDINARY_API_KEY=your_primary_api_key
CLOUDINARY_API_SECRET=your_primary_api_secret

# ── Dedicated Video Cloudinary (Video Streaming & Course Assets) ──────────────
CLOUDINARY_VIDEO_CLOUD_NAME=your_video_cloud_name
CLOUDINARY_VIDEO_API_KEY=your_video_api_key
CLOUDINARY_VIDEO_API_SECRET=your_video_api_secret

# ── Logging ───────────────────────────────────────────────────────────────────
# Options: trace | debug | info | warn | error | fatal
LOG_LEVEL=debug

# ── Razorpay Payment Gateway ──────────────────────────────────────────────────
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ── App & Feature Cutoffs ─────────────────────────────────────────────────────
# Used to build referral URLs: https://{APP_DOMAIN}/ref/{code}
APP_DOMAIN=localhost:3000

# Legacy Language Selection Cutoff (ISO 8601 UTC timestamp)
# Accounts created BEFORE this cutoff with NULL assigned language are marked languageSelectionRequired=true
LEGACY_LANGUAGE_SELECTION_CUTOFF=2026-08-14T14:40:00.000Z
