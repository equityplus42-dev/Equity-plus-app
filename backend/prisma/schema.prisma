// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String          @id @default(uuid())
  email                   String          @unique
  password                String
  role                    String          @default("USER") // USER, ADMIN
  referralCode            String          @unique
  referralUrl             String?         @db.VarChar(255)
  qrCode                  String?         @db.Text
  referrerId              String?
  points                  Int             @default(0) // Referral rewards points balance
  isApproved              Boolean         @default(true) // Admin can suspend/approve
  isActive                Boolean         @default(true)
  isDeleted               Boolean         @default(false)
  deletedAt               DateTime?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  otpCode                 String?
  otpExpiresAt            DateTime?
  otpCount                Int             @default(0)

  // Relations
  profile                 Profile?
  referrer                User?           @relation("UserReferrals", fields: [referrerId], references: [id], onDelete: SetNull)
  referrals               User[]          @relation("UserReferrals")
  referralRecordAsReferee Referral?       @relation("RefereeRecord")
  referralRecordsAsReferrer Referral[]    @relation("ReferrerRecords")
  hierarchyNode           HierarchyNode?
  notifications           Notification[]
  auditLogs               AuditLog[]
  videoProgress           UserVideoProgress[]
  videoSnapshot           UserVideoSnapshot?
  languageRequests        LanguageChangeRequest[] @relation("UserLanguageRequests")
  reviewedRequests        LanguageChangeRequest[] @relation("ReviewedLanguageRequests")
  playbackSessions        PlaybackSession[]
  payments                Payment[]
  productAccesses         UserProductAccess[]
  refundRequests          RefundRequest[]
  videoAssignments        VideoAssignment[]

  @@index([referrerId])
}

model Profile {
  id                   String    @id @default(uuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName            String?
  lastName             String?
  phoneNumber          String?
  whatsApp             String?
  state                String?
  district             String?
  avatarUrl            String?
  bio                  String?   @db.Text
  panNumber            String?
  aadharNumber         String?
  assignedLanguageId   String?
  assignedLanguage     Language? @relation(fields: [assignedLanguageId], references: [id], onDelete: SetNull)
  assignedProductId    String?
  assignedProduct      Product?  @relation(fields: [assignedProductId], references: [id], onDelete: SetNull)
  disclaimerAcceptedAt DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([phoneNumber])
  @@index([assignedLanguageId])
  @@index([assignedProductId])
}

model Product {
  id          String              @id @default(uuid())
  name        String              @unique
  code        String              @unique
  description String?             @db.Text
  price       Int                 @default(1000) // Price in rupees (e.g. 1000 INR)
  status      String              @default("AVAILABLE") // DRAFT, AVAILABLE, ARCHIVED
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  videos      Video[]
  profiles    Profile[]
  payments    Payment[]
  productAccesses UserProductAccess[]
}

model Language {
  id                      String                  @id @default(uuid())
  name                    String                  @unique // e.g. English, Hindi, Bengali
  code                    String                  @unique // e.g. en, hi, bn
  isDefault               Boolean                 @default(false)
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  videos                  Video[]
  profiles                Profile[]
  snapshots               UserVideoSnapshot[]
  currentLangRequests     LanguageChangeRequest[] @relation("CurrentLanguageRequests")
  requestedLangRequests   LanguageChangeRequest[] @relation("RequestedLanguageRequests")
}

model Video {
  id                   String              @id @default(uuid())
  title                String
  description          String?             @db.Text
  videoUrl             String              @db.VarChar(512)
  thumbnailUrl String?             @db.VarChar(512)
  duration     Int                 @default(0)
  languageId   String
  language     Language            @relation(fields: [languageId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  status       String              @default("AVAILABLE") // DRAFT, UPLOADED, AVAILABLE, ASSIGNED, IN_USE, ARCHIVED
  orderIndex   Int                 @default(0)
  currentVersionNumber Int                 @default(1)
  isActive     Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  progressList   UserVideoProgress[]
  versions       VideoVersion[]
  sessions       PlaybackSession[]
  assignments    VideoAssignment[]
  snapshotVideos SnapshotVideo[]

  @@index([languageId])
  @@index([productId])
}

model VideoVersion {
  id            String   @id @default(uuid())
  videoId       String
  video         Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  versionNumber Int      @default(1)
  title         String
  description   String?  @db.Text
  videoUrl      String   @db.VarChar(512)
  thumbnailUrl  String?  @db.VarChar(512)
  duration      Int      @default(0)
  changeLog     String?  @db.Text
  createdBy     String?
  createdAt     DateTime @default(now())

  @@unique([videoId, versionNumber])
  @@index([videoId])
}

model PlaybackSession {
  id                   String    @id @default(uuid())
  sessionId            String    @unique
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoId              String
  video                Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)
  snapshotId           String?
  deviceId             String?
  deviceName           String?
  platform             String?
  ipAddress            String?
  startedAt            DateTime  @default(now())
  endedAt              DateTime?
  watchSeconds         Int       @default(0)
  lastPositionSecs     Int       @default(0)
  pauseCount           Int       @default(0)
  resumeCount          Int       @default(0)
  seekCount            Int       @default(0)
  backgroundCount      Int       @default(0)
  networkInterruptions Int       @default(0)
  closedNormally       Boolean   @default(false)

  @@index([userId])
  @@index([videoId])
  @@index([startedAt])
}

model Announcement {
  id          String    @id @default(uuid())
  title       String
  message     String    @db.Text
  targetType  String    @default("ALL") // ALL, PRODUCT, LANGUAGE, USER
  targetId    String?
  scheduledAt DateTime?
  isSent      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  createdById String?

  @@index([targetType])
  @@index([isSent])
}

model UserVideoProgress {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoId     String
  video       Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  watchedSecs Int      @default(0)
  isCompleted Boolean  @default(false)
  lastWatched DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, videoId])
  @@index([userId])
}

model LanguageChangeRequest {
  id                  String    @id @default(uuid())
  userId              String
  user                User      @relation("UserLanguageRequests", fields: [userId], references: [id], onDelete: Cascade)
  currentLanguageId   String
  currentLanguage     Language  @relation("CurrentLanguageRequests", fields: [currentLanguageId], references: [id], onDelete: Cascade)
  requestedLanguageId String
  requestedLanguage   Language  @relation("RequestedLanguageRequests", fields: [requestedLanguageId], references: [id], onDelete: Cascade)
  reason              String    @db.Text
  status              String    @default("PENDING") // PENDING, APPROVED, REJECTED, CANCELLED
  adminRemarks        String?   @db.Text
  requestedAt         DateTime  @default(now())
  reviewedAt          DateTime?
  reviewedBy          String?
  reviewer            User?     @relation("ReviewedLanguageRequests", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
}

model UserVideoSnapshot {
  id                           String          @id @default(uuid())
  userId                       String          @unique
  user                         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  languageId                   String
  language                     Language        @relation(fields: [languageId], references: [id], onDelete: Cascade)
  snapshotTakenAt              DateTime        @default(now())
  snapshotVideoCount           Int
  snapshotTotalDurationSeconds Int
  refundThresholdPercentage    Int             @default(25)
  refundEligible               Boolean         @default(true)
  refundLostAt                 DateTime?
  newVideosUnlocked            Boolean         @default(false)
  disclaimerVersion            Int             @default(1)
  acceptedDisclaimerAt         DateTime?
  createdAt                    DateTime        @default(now())
  updatedAt                    DateTime        @updatedAt
  snapshotVideos               SnapshotVideo[]
  refundRequests               RefundRequest[]

  @@index([userId])
  @@index([languageId])
}

model SnapshotVideo {
  id                   String            @id @default(uuid())
  snapshotId           String
  snapshot             UserVideoSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  videoId              String
  video                Video             @relation(fields: [videoId], references: [id], onDelete: Cascade)
  videoDurationSeconds Int
  createdAt            DateTime          @default(now())

  @@index([snapshotId])
  @@index([videoId])
}

model Referral {
  id         String   @id @default(uuid())
  referrerId String
  refereeId  String   @unique
  referrer   User     @relation("ReferrerRecords", fields: [referrerId], references: [id], onDelete: Cascade)
  referee    User     @relation("RefereeRecord", fields: [refereeId], references: [id], onDelete: Cascade)
  status     String   @default("PENDING") // PENDING, APPROVED, REJECTED
  points     Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([referrerId])
  @@index([status])
  @@index([referrerId, status])
}

model HierarchyNode {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId  String?
  path      String   @db.VarChar(511) // Materialized path, e.g. "/root-uuid/parent-uuid/user-uuid"
  level     Int      // Depth in hierarchy, root is 0
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([path])
  @@index([parentId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  type      String   @default("SYSTEM") // SYSTEM, REFERRAL_SIGNUP, REFERRAL_APPROVED, REWARD, PAYMENT, REFUND
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model SystemSettings {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String   @db.Text
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  action      String
  ipAddress   String?
  userAgent   String?
  details     String?  @db.Text
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model Payment {
  id            String              @id @default(uuid())
  userId        String
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  orderId       String              @unique
  paymentId     String?             @unique
  signature     String?             @db.Text
  amount        Int                 // Amount in paise
  currency      String              @default("INR")
  status        String              @default("CREATED") // CREATED, PENDING, SUCCESS, FAILED, CANCELLED, VERIFICATION_FAILED, REFUNDED, PARTIALLY_REFUNDED
  failureReason String?             @db.Text
  verifiedAt    DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  productAccesses UserProductAccess[]
  refundRequests  RefundRequest[]

  @@index([userId])
  @@index([productId])
  @@index([orderId])
  @@index([status])
}

model UserProductAccess {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  paymentId   String?
  payment     Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  status      String    @default("PENDING_APPROVAL") // PENDING_PAYMENT, PAYMENT_SUCCESS, PENDING_APPROVAL, ACTIVE, SUSPENDED, REVOKED, EXPIRED
  assignedAt  DateTime  @default(now())
  approvedAt  DateTime?
  approvedBy  String?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([productId])
  @@index([status])
}

model RefundRequest {
  id                String             @id @default(uuid())
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentId         String
  payment           Payment            @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  snapshotId        String?
  snapshot          UserVideoSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: SetNull)
  amount            Int
  reason            String             @db.Text
  bankDetails       String?            @db.Text
  additionalDetails String?            @db.Text
  status            String             @default("PENDING") // PENDING, UNDER_REVIEW, APPROVED, REJECTED, PROCESSED, CANCELLED
  adminRemarks      String?            @db.Text
  requestedAt       DateTime           @default(now())
  reviewedAt        DateTime?
  reviewedBy        String?
  processedAt       DateTime?
  processedBy       String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([userId])
  @@index([paymentId])
  @@index([status])
}

model VideoAssignment {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoId      String
  video        Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)
  productId    String?
  languageId   String?
  status       String    @default("ACTIVE") // ACTIVE, SUSPENDED, REVOKED, EXPIRED
  assignedAt   DateTime  @default(now())
  assignedBy   String?
  unassignedAt DateTime?
  unassignedBy String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, videoId])
  @@index([userId])
  @@index([videoId])
  @@index([status])
}
